---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AuthButton from '../components/AuthButton';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        document.documentElement.classList.toggle('light', localStorage.getItem('theme') === 'light');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="bg-zinc-950 text-white antialiased min-h-screen">
    <header class="sticky top-0 z-50 bg-zinc-950/85 backdrop-blur-md border-b border-zinc-800/60">
      <div class="max-w-7xl mx-auto px-6 h-14 flex items-center gap-1">

        <a href="/" class="flex items-center gap-2.5 mr-5 group">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-emerald-400 via-teal-400 to-violet-500 flex items-center justify-center flex-shrink-0 shadow-lg shadow-emerald-500/20 group-hover:shadow-emerald-500/40 transition-shadow duration-300">
            <span class="text-white text-xs font-black tracking-tight">T</span>
          </div>
          <span class="font-bold text-base text-white group-hover:text-zinc-200 transition-colors">TIOKhor</span>
        </a>

        <nav class="flex items-center gap-0.5">
          <a
            href="/music"
            class:list={[
              "relative px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200",
              path.startsWith("/music")
                ? "text-violet-300 bg-violet-500/12"
                : "text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800/70",
            ]}
          >
            {path.startsWith("/music") && (
              <span class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-violet-400"></span>
            )}
            Music
          </a>
          <a
            href="/movies"
            class:list={[
              "relative px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200",
              path.startsWith("/movies")
                ? "text-rose-300 bg-rose-500/12"
                : "text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800/70",
            ]}
          >
            {path.startsWith("/movies") && (
              <span class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-rose-400"></span>
            )}
            Movies
          </a>
          <a
            href="/games"
            class:list={[
              "relative px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200",
              path.startsWith("/games")
                ? "text-emerald-300 bg-emerald-500/12"
                : "text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800/70",
            ]}
          >
            {path.startsWith("/games") && (
              <span class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-emerald-400"></span>
            )}
            Games
          </a>
          <div class="w-px h-4 bg-zinc-800 mx-1.5"></div>
          <a
            href="/discover"
            class:list={[
              "relative px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200",
              path.startsWith("/discover")
                ? "text-cyan-300 bg-gradient-to-r from-cyan-500/15 to-indigo-500/15"
                : "text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800/70",
            ]}
          >
            {path.startsWith("/discover") && (
              <span class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-cyan-400"></span>
            )}
            ✦ Discover
          </a>
          <div class="w-px h-4 bg-zinc-800 mx-1.5"></div>
          <a
            href="/friends"
            class:list={[
              "relative px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-200",
              path.startsWith("/friends")
                ? "text-sky-300 bg-sky-500/12"
                : "text-zinc-500 hover:text-zinc-200 hover:bg-zinc-800/70",
            ]}
          >
            {path.startsWith("/friends") && (
              <span class="absolute bottom-0.5 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-sky-400"></span>
            )}
            Friends
          </a>
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <ThemeToggle client:load />
          <div class="w-px h-5 bg-zinc-800 mx-1"></div>
          <AuthButton client:load />
        </div>

      </div>
    </header>
    <slot />
  </body>
</html>
